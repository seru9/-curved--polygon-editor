<Window x:Class="_curved__polygon_editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_curved__polygon_editor"
        xmlns:vm="clr-namespace:_curved__polygon_editor.ViewModels"
        xmlns:helpers="clr-namespace:_curved__polygon_editor.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <helpers:EdgeToGeometryConverter x:Key="EdgeToGeometryConverter" />
        <helpers:SubtractConverter x:Key="SubtractConverter" />
    </Window.Resources>
    <Grid>
        <!-- Główny Canvas zajmujący całe okno -->
        <Canvas ClipToBounds="True" Background="White">

            <!-- Iteracja po wielokątach -->
            <ItemsControl ItemsSource="{Binding Polygons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Canvas rozciągnięty na całą dostępną przestrzeń, żeby Canvas.Left/Top działały poprawnie -->
                        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!-- 1. Krawędzie -->
                            <ItemsControl ItemsSource="{Binding Edges}"
                                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding ., Converter={StaticResource EdgeToGeometryConverter}}"
                                              Stroke="Black" StrokeThickness="2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 2. Wierzchołki (kółka) -->
                            <!-- Canvas.Left/Top musi być na ContentPresenter (bezpośrednim dziecku Canvas), nie na Ellipse wewnątrz DataTemplate -->
                            <ItemsControl ItemsSource="{Binding Vertices}"
                                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource SubtractConverter}, ConverterParameter=4}" />
                                        <Setter Property="Canvas.Top"  Value="{Binding Y, Converter={StaticResource SubtractConverter}, ConverterParameter=4}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="Red" Stroke="DarkRed" StrokeThickness="1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Canvas>
    </Grid>
</Window>