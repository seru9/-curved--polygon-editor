<Window x:Class="_curved__polygon_editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_curved__polygon_editor"
        xmlns:vm="clr-namespace:_curved__polygon_editor.ViewModels"
        xmlns:helpers="clr-namespace:_curved__polygon_editor.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        KeyDown="Window_KeyDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:EdgeToGeometryConverter x:Key="EdgeToGeometryConverter" />
        <helpers:SubtractConverter x:Key="SubtractConverter" />

        <Style x:Key="VertexEllipseStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="Red" />
            <Setter Property="Stroke" Value="DarkRed" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Fill" Value="Gold" />
                    <Setter Property="Stroke" Value="DarkOrange" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Styl dla punktów kontrolnych Beziera (V1, V2) -->
        <Style x:Key="ControlPointEllipseStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="LimeGreen" />
            <Setter Property="Stroke" Value="DarkGreen" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="EdgePathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="Black" />
            <Setter Property="StrokeThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="DodgerBlue" />
                    <Setter Property="StrokeThickness" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pasek narzędzi -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="6" VerticalAlignment="Center">
            <Button Content="Dodaj wierzchołek" Click="AddVertexButton_Click" Margin="0,0,6,0" />
            <Button Content="Usuń wierzchołek" Click="DeleteVertexButton_Click" Margin="0,0,6,0" />
            <Button Content="Ustaw długość" Click="LengthButton_Click" Margin="0,0,6,0" />
            <Button Content="Usuń ograniczenie" Click="RemoveConstraintButton_Click" Margin="0,0,6,0" />
            <Button Content="Ustaw prostopadłość" Click="PerpendicularButton_Click" Margin="0,0,6,0" />
            <Button Content="Przełącz Bezier" Click="BezierButton_Click" Margin="0,0,6,0" />
            <Button Content="Przełącz Łuk" Click="ArcButton_Click" Margin="0,0,6,0" />
            <Button Content="G0" Click="SetG0Button_Click" Margin="0,0,3,0" Padding="6,2" />
            <Button Content="G1" Click="SetG1Button_Click" Margin="0,0,3,0" Padding="6,2" />
            <Button Content="C1" Click="SetC1Button_Click" Margin="0,0,6,0" Padding="6,2" />
            <Button Content="Wyczyść zaznaczenie" Click="ClearSelectionButton_Click" Margin="0,0,12,0" />
            <RadioButton x:Name="LibraryLineRadio"
                 Content="Funkcja biblioteczna"
                 GroupName="LineDrawMode"
                 IsChecked="True"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Checked="LineDrawingMode_Checked" />
            <RadioButton x:Name="BresenhamLineRadio"
                 Content="Bresenham"
                 GroupName="LineDrawMode"
                 VerticalAlignment="Center"
                 Checked="LineDrawingMode_Checked" />
        </WrapPanel>

        <!-- Główny Canvas -->
        <Canvas x:Name="DrawingCanvas" Grid.Row="1" ClipToBounds="True" Background="White"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp">

            <!-- Iteracja po wielokątach -->
            <ItemsControl ItemsSource="{Binding Polygons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Canvas rozciągnięty na całą dostępną przestrzeń, żeby Canvas.Left/Top działały poprawnie -->
                        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                            <!-- 1. Krawędzie oraz ich punkty kontrolne Beziera -->
                            <ItemsControl ItemsSource="{Binding Edges}"
                                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <!-- Wielobok pomocniczy Beziera i punkty kontrolne (widoczne tylko gdy IsBezier == true) -->
                                            <Canvas Visibility="{Binding IsBezier, Converter={StaticResource BoolToVis}}">
                                                <!-- Linia V0 -> V1 -->
                                                <Line X1="{Binding StartVertex.X}" Y1="{Binding StartVertex.Y}"
                                                      X2="{Binding ControlPoint1.X}" Y2="{Binding ControlPoint1.Y}"
                                                      Stroke="Gray" StrokeThickness="1" StrokeDashArray="4 2" />
                                                <!-- Linia V1 -> V2 -->
                                                <Line X1="{Binding ControlPoint1.X}" Y1="{Binding ControlPoint1.Y}"
                                                      X2="{Binding ControlPoint2.X}" Y2="{Binding ControlPoint2.Y}"
                                                      Stroke="LightGray" StrokeThickness="1" StrokeDashArray="2 2" />
                                                <!-- Linia V2 -> V3 -->
                                                <Line X1="{Binding ControlPoint2.X}" Y1="{Binding ControlPoint2.Y}"
                                                      X2="{Binding EndVertex.X}" Y2="{Binding EndVertex.Y}"
                                                      Stroke="Gray" StrokeThickness="1" StrokeDashArray="4 2" />

                                                <!-- Punkt kontrolny V1 -->
                                                <Ellipse Style="{StaticResource ControlPointEllipseStyle}"
                                                         Canvas.Left="{Binding ControlPoint1.X, Converter={StaticResource SubtractConverter}, ConverterParameter=4}"
                                                         Canvas.Top="{Binding ControlPoint1.Y, Converter={StaticResource SubtractConverter}, ConverterParameter=4}" />

                                                <!-- Punkt kontrolny V2 -->
                                                <Ellipse Style="{StaticResource ControlPointEllipseStyle}"
                                                         Canvas.Left="{Binding ControlPoint2.X, Converter={StaticResource SubtractConverter}, ConverterParameter=4}"
                                                         Canvas.Top="{Binding ControlPoint2.Y, Converter={StaticResource SubtractConverter}, ConverterParameter=4}" />
                                            </Canvas>

                                            <!-- Główna linia / krzywa Beziera / łuk -->
                                            <Path Data="{Binding Self, Converter={StaticResource EdgeToGeometryConverter}}"
                                                  Style="{StaticResource EdgePathStyle}" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 2. Wierzchołki (kółka) -->
                            <ItemsControl ItemsSource="{Binding Vertices}"
                                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource SubtractConverter}, ConverterParameter=4}" />
                                        <Setter Property="Canvas.Top"  Value="{Binding Y, Converter={StaticResource SubtractConverter}, ConverterParameter=4}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Ellipse Style="{StaticResource VertexEllipseStyle}" />
                                            <TextBlock Text="{Binding ContinuityText}"
                                                       FontSize="10" FontWeight="Bold" Foreground="DarkSlateBlue"
                                                       Canvas.Left="10" Canvas.Top="-6" IsHitTestVisible="False" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 3. Ikony aktywnych ograniczeń -->
            <ItemsControl ItemsSource="{Binding ConstraintVisuals}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource SubtractConverter}, ConverterParameter=8}" />
                        <Setter Property="Canvas.Top"  Value="{Binding Y, Converter={StaticResource SubtractConverter}, ConverterParameter=8}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFF3B0" BorderBrush="Orange" BorderThickness="1"
                                CornerRadius="3" Padding="2,1">
                            <TextBlock Text="{Binding Text}" FontSize="10" Foreground="#B8860B" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Canvas>
    </Grid>
</Window>